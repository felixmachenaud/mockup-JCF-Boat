# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.jcfboat.fr

# Google Maps JavaScript API — requis pour la carte des calanques
# https://console.cloud.google.com/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin CMS (/admin)
# Préférer un hash scrypt : npm run hash-admin-password -- "votre-mot-de-passe"
ADMIN_PASSWORD_HASH=
# Fallback temporaire (migration) — à retirer une fois le hash en place
# ADMIN_PASSWORD=

# Secret HMAC / sessions — OBLIGATOIRE en production (≥ 32 caractères)
# Ne jamais réutiliser le mot de passe. Générer : openssl rand -base64 32
AUTH_SECRET=

# Upstash Redis — rate limiting partagé (login, contact, upload)
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — anti-spam formulaires
# https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob (production) — OBLIGATOIRE pour CMS + sessions + uploads
# Un store privé est OK : les photos passent par /api/media
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# SMTP OVH / Zimbra — formulaires contact & réservation
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=contact@jcfboat.fr
# CONTACT_TO=contact@jcfboat.fr
