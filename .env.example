# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.jcfboat.fr

# Google Maps JavaScript API — requis pour la carte des calanques
# https://console.cloud.google.com/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin CMS (/admin) — OBLIGATOIRE en production
# Générer : openssl rand -base64 32
ADMIN_PASSWORD=

# Secret HMAC du cookie de session admin (recommandé, distinct du mot de passe)
# Générer : openssl rand -base64 32
AUTH_SECRET=

# Vercel Blob (production) — sinon stockage local data/site-content.json
BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# SMTP OVH / Zimbra — formulaires contact & réservation
# Compte email Zimbra (ex. contact@jcfboat.fr) + mot de passe
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Expéditeur (par défaut = SMTP_USER)
# SMTP_FROM=contact@jcfboat.fr
# Destinataire des messages (par défaut = SMTP_USER)
# CONTACT_TO=contact@jcfboat.fr
